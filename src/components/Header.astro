---
import { tools } from '../tools.ts';
import { site, cleanPath } from '../site.ts';
import Logo from './Logo.astro';

const current = cleanPath(Astro.url.pathname);
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/"><Logo />{site.name}</a>
    <nav class="menu" aria-label="Primary">
      <div class="dropdown-wrap">
        <button
          type="button"
          class="menu-btn"
          id="all-tools-btn"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="all-tools-menu"
        >
          All tools
          <svg class="chev" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="dropdown" id="all-tools-menu" hidden>
          {tools.map((t, i) => (
            <a href={t.href} style={`--i: ${i}`} aria-current={current === t.href ? 'page' : undefined}>{t.name}</a>
          ))}
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('all-tools-btn');
  const menu = document.getElementById('all-tools-menu');
  if (btn && menu) {
    const close = () => {
      menu.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    };
    const open = () => {
      menu.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.hidden ? open() : close();
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && e.target instanceof Node && !menu.contains(e.target) && e.target !== btn && !btn.contains(e.target)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        close();
        btn.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }
  .inner {
    max-width: calc(var(--content) + 32px);
    margin: 0 auto;
    padding: 0 16px;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.016em;
    white-space: nowrap;
  }
  .menu {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 500;
  }
  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    text-decoration: none;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    padding: 8px 16px;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color .15s, border-color .15s, scale .15s;
  }
  .menu-btn:hover {
    background: var(--cream);
  }
  .menu-btn:active {
    scale: .96;
  }
  .menu-btn[aria-expanded='true'] {
    background: var(--cream);
    border-color: var(--ink);
  }
  .chev {
    transition: rotate .4s cubic-bezier(.3, 1.4, .6, 1);
  }
  .menu-btn[aria-expanded='true'] .chev {
    rotate: 180deg;
  }
  .dropdown-wrap {
    position: relative;
  }
  .chev {
    flex: none;
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 260px;
    background: var(--paper);
    border: 1px solid var(--ink);
    border-radius: var(--radius-sm);
    padding: 8px;
    display: grid;
    z-index: 50;
    transform-origin: top right;
    transition: opacity .2s, translate .3s cubic-bezier(.3, 1.3, .6, 1), scale .3s cubic-bezier(.3, 1.3, .6, 1), filter .2s, display .2s allow-discrete;
  }
  .dropdown[hidden] {
    display: none;
    opacity: 0;
    translate: 0 -5px;
    scale: .95;
    filter: blur(4px);
  }
  @starting-style {
    .dropdown:not([hidden]) {
      opacity: 0;
      translate: 0 -5px;
      scale: .95;
      filter: blur(4px);
    }
  }
  .dropdown a {
    color: var(--ink);
    text-decoration: none;
    font-size: 14px;
    padding: 8px 12px;
    border-radius: var(--radius-input);
    transition: background-color .15s, scale .15s;
    animation: item-in .3s cubic-bezier(.3, 1.3, .6, 1) both;
    animation-delay: calc(var(--i) * 25ms);
  }
  @keyframes item-in {
    from { opacity: 0; translate: 6px 0; filter: blur(4px); }
  }
  .dropdown a:hover {
    background: var(--cream);
  }
  .dropdown a:active {
    scale: .98;
  }
  .dropdown a:focus-visible {
    outline-offset: -2px;
  }
  .dropdown a[aria-current='page'] {
    background: var(--sun);
    font-weight: 500;
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-btn, .chev, .dropdown, .dropdown a {
      transition: none;
      animation: none;
    }
  }
  @media (max-width: 640px) {
    .menu {
      gap: 4px;
      font-size: 14px;
    }
    .brand {
      font-size: 18px;
    }
    .menu-btn {
      padding: 8px 10px;
    }
  }
</style>
