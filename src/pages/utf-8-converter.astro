---
import Layout from '../layouts/Layout.astro';
import ToolShell from '../components/ToolShell.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
---

<Layout title="UTF-8 converter: fix garbled subtitle and text files" description="Turn a subtitle or text file saved in Windows-1251, Shift-JIS, GBK or another old encoding into UTF-8, so accents and non-Latin letters show up right. Your file stays on your device.">
  <h1>UTF-8 converter</h1>
  <p class="lede">Fix garbled subtitle text such as <code>Ã©</code>, <code>ÐŸÑ€Ð¸Ð²ÐµÑ‚</code>, or <code>????</code> by saving the file as UTF-8.</p>

  <ToolShell columns={['Line', 'Text']} label="Choose a file" accept="" hint="Any text file: subtitles, scripts, lyrics" />

  <section class="help">
    <h2>How to use it</h2>
    <p>Upload the subtitle or text file and inspect the preview. Under <strong>Read as</strong>, try another source encoding until accents, Cyrillic, Japanese, Korean, or Chinese text looks correct.</p>
    <h2>Encodings to try</h2>
    <p>Common fixes include Windows-1252 for Western European text, Windows-1251 for Cyrillic, Shift-JIS for Japanese, GBK for Simplified Chinese, Big5 for Traditional Chinese, and EUC-KR for Korean.</p>
    <h2>Garbled text examples</h2>
    <pre><code>Wrong UTF-8 read as Windows-1252: Ã©
Correct text:                       é

Wrong Cyrillic read as UTF-8: ÐŸÑ€Ð¸Ð²ÐµÑ‚
Correct text:                      Привет</code></pre>
    <h2>What the download changes</h2>
    <p>The download contains the same text saved as UTF-8 without a byte order mark. Line endings and every other character stay unchanged. This works for SRT, WebVTT, ASS, SSA, SAMI, MicroDVD, MPL2, scripts or other text files.</p>
    <h2>Common errors</h2>
    <p>If every option produces replacement characters such as <code>�</code> or question marks, the source may already have lost its original bytes. Reopen the original file, choose the encoding that makes the preview readable, then <a href="/subtitle-validator">validate the subtitle</a> or <a href="/srt-cleaner">clean its tags</a>.</p>
  </section>

  <Faq items={[
    { question: 'How do I fix garbled subtitle text?', answer: 'Upload the original file and try another source encoding until the preview reads correctly. Then download the UTF-8 file.' },
    { question: 'Which encoding should I try for Japanese or Chinese?', answer: 'Try Shift-JIS for Japanese, GBK for Simplified Chinese, and Big5 for Traditional Chinese. Try Windows-1251 for Cyrillic text.' },
    { question: 'Does this change my subtitle timing?', answer: 'No. It saves the same text as UTF-8. It does not change subtitle times, line endings, or other characters.' },
  ]} />

  <RelatedTools tools={[
    { href: '/subtitle-validator', label: 'Validate the subtitle', description: 'Check the repaired file for timing and text problems.' },
    { href: '/srt-cleaner', label: 'Clean subtitle tags', description: 'Remove HTML, ASS tags, SDH notes, and duplicate cues.' },
    { href: '/convert-to-srt', label: 'Convert to SRT', description: 'Make an SRT after the text displays correctly.' },
    { href: '/subtitle-shifter', label: 'Fix subtitle timing', description: 'Move every cue earlier or later by one offset.' },
  ]} />
</Layout>

<script>
  import { mountTool } from '../components/tool-shell.ts';

  const encoding = document.getElementById('encoding') as HTMLSelectElement;
  let text = '';

  mountTool({
    parse: (t) => ((text = t), { file: { format: 'txt', cues: [] }, problems: [] }),
    view(_parsed, { previewLimit = 200 } = {}) {
      const lines = text.split(/\r\n?|\n/);
      const utf8 = encoding.value === 'UTF-8';
      return {
        summary: `${lines.length} lines, read as ${encoding.value}.`,
        warnings: utf8 ? ['This file is already UTF-8. You can still download it with any byte order mark removed.'] : [],
        rows: lines.slice(0, previewLimit).map((l, i) => ({ cells: [String(i + 1), l] })),
        total: lines.length,
      };
    },
    output: () => text,
  });
</script>

