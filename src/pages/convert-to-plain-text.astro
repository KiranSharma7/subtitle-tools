---
import Layout from '../layouts/Layout.astro';
import ToolShell from '../components/ToolShell.astro';
---

<Layout title="Convert subtitles to plain text: get the dialogue as a .txt file" description="Turn SRT, WebVTT, ASS, SAMI and other subtitles into plain text. Timing, cue numbers and formatting tags are removed. Free, and your file stays on your device.">
  <h1>Convert to plain text</h1>
  <p class="lede">Get just the dialogue, with no timestamps, cue numbers or tags.</p>

  <ToolShell columns={['#', 'Text']}>
    <label class="option"><input id="keep" type="checkbox" checked /> Keep line breaks</label>
  </ToolShell>

  <section class="help">
    <h2>How to use it</h2>
    <p>Choose an SRT, WebVTT, ASS, SSA, SAMI, MicroDVD or MPL2 file. The preview shows the text of each cue with the timing and formatting tags removed.</p>
    <p>Cue ids, cue settings, styles and the file header are dropped too. Anything that gets dropped is listed above the preview.</p>
    <p>With <em>Keep line breaks</em> on, each cue keeps its lines and cues are separated by a blank line. Turn it off to put each cue on one line.</p>
    <p>The download is saved as UTF-8 with the same name and a <code>.txt</code> extension. Plain text has no timing, so it can't be turned back into subtitles.</p>
  </section>
</Layout>

<script>
  import { plainText, write } from '../engine/formats.ts';
  import { convert } from '../engine/convert.ts';
  import { mountTool } from '../components/tool-shell.ts';
  import { lossWarnings } from '../components/converter.ts';

  const keep = document.getElementById('keep') as HTMLInputElement;

  const render = mountTool({
    view({ file }) {
      const r = convert(file, 'txt');
      return {
        warnings: lossWarnings(r.losses),
        // Cues with no text left are left out of the download, so leave them out here too.
        rows: r.file.cues
          .map((c, i) => ({ cells: [String(i + 1), plainText(c.text, keep.checked)] }))
          .filter((r) => r.cells[1]),
      };
    },
    output: ({ file }) => write(file, 'txt', { keepLineBreaks: keep.checked }),
    filename: (name) => name.replace(/\.[^.]*$/, '') + '.txt',
  });

  keep.addEventListener('change', render);
</script>

<style>
  .option { display: flex; gap: 8px; align-items: center; font-weight: 600; }
  .tool :global(td:first-child) { white-space: nowrap; font-variant-numeric: tabular-nums; }
</style>
