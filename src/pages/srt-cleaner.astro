---
import Layout from '../layouts/Layout.astro';
import ToolShell from '../components/ToolShell.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { defaultCleanOptions } from '../engine/clean.ts';

const d = defaultCleanOptions;
type Opt = readonly [name: string, label: string, value?: string];
type Row = readonly [legend: string, opts: readonly Opt[], id?: string];
const on = ([name, , value]: Opt) => (value ? d.keep.includes(value as never) : Boolean(d[name as keyof typeof d]));
// Only the common rules show. The rest wait behind More options, in the same rows.
const main: Row[] = [
  ['Remove', [['htmlTags', 'HTML tags'], ['musicNotes', 'Music cues ♪'], ['duplicates', 'Duplicate cues'], ['empty', 'Empty cues']]],
  ['Risky', [['sdh', 'SDH notes like [DOOR SLAMS]'], ['speakers', 'Speaker labels like JOHN:']]],
];
const more: Row[] = [
  ['Keep tags', [['keep', 'italic', 'i'], ['keep', 'bold', 'b'], ['keep', 'font', 'font']], 'keep'],
  ['Remove text in', [['parens', '( )'], ['brackets', '[ ]'], ['braces', '{ }'], ['asterisks', '*asterisks*'], ['hashtags', '#hashtags#']]],
  ['Also remove', [['assTags', 'ASS tags like {\\an8}'], ['watermarks', 'Subtitle-site credits']]],
  ['Fix', [['lineBreaks', 'Unnecessary line breaks'], ['uppercase', 'ALL-CAPS to normal case'], ['merge', 'Merge back-to-back repeats']]],
];
---

<Layout title="SRT cleaner online: remove tags and SDH" description="Clean SRT, WebVTT, ASS, SSA, SAMI, MicroDVD, or MPL2 files. Remove HTML tags, SDH notes, labels, music cues, duplicates, and empty cues in your browser.">
  <h1>SRT cleaner: remove tags and SDH notes</h1>
  <p class="lede">Clean subtitle text by removing tags, SDH notes, speaker labels, music cues, duplicates, and empty cues.</p>

  <ToolShell columns={['#', 'Before', 'After']}>
    <form id="opts">
      {main.map(([legend, opts]) => (
        <fieldset>
          <legend>{legend}</legend>
          {opts.map((o) => <label class="chip"><input type="checkbox" name={o[0]} value={o[2]} checked={on(o)} /> {o[1]}</label>)}
          {legend === 'Risky' && <span class="hint">Can cut real dialogue. Check the preview.</span>}
        </fieldset>
      ))}
      <details>
        <summary>More options</summary>
        <div class="rows">
          {more.map(([legend, opts, id]) => (
            // Keep tags only applies to HTML tag removal, so it switches off with it.
            <fieldset id={id} disabled={id === 'keep' && !d.htmlTags}>
              <legend>{legend}</legend>
              {opts.map((o) => <label class="chip"><input type="checkbox" name={o[0]} value={o[2]} checked={on(o)} /> {o[1]}</label>)}
            </fieldset>
          ))}
        </div>
      </details>
    </form>
  </ToolShell>

  <section class="help">
    <h2>How to clean an SRT file</h2>
    <p>Choose cleanup rules, compare changed cues in the preview, then download. Safe formatting rules start on. Rules that may remove dialogue stay off.</p>
    <h2>What the SRT cleaner removes</h2>
    <p>Clean SRT, WebVTT, ASS, SSA, SAMI, MicroDVD, or MPL2 files. Remove HTML and ASS tags, SDH descriptions, speaker labels, music cues, duplicate cues, empty cues, extra line breaks, or ALL-CAPS text.</p>
    <h2>Before and after</h2>
    <p>Turn on speaker-label or SDH removal only when you have checked the preview. A line such as <code>[I agree]</code> may be dialogue, while <code>[DOOR SLAMS]</code> is a description.</p>
    <pre><code>Before: &lt;i&gt;JOHN:&lt;/i&gt; [DOOR SLAMS]
After:  JOHN:        (speaker labels kept)</code></pre>
    <h2>How cleanup works</h2>
    <p>Rules run in a fixed order. Removing empty cues runs last, so a cue that becomes empty after removing <code>[music]</code> is removed too. The download stays in the same format and is saved as UTF-8.</p>
    <h2>If the result needs another pass</h2>
    <p>If tags still show, enable both HTML and ASS tag removal. If text disappeared, turn off the risky rule that removed it and download again. If the cleaned file has timing errors, <a href="/subtitle-validator">validate it</a> before conversion.</p>
  </section>

  <Faq title="SRT cleaner FAQ" items={[
    { question: 'What can an SRT cleaner remove?', answer: 'It can remove HTML and ASS tags, SDH notes, speaker labels, bracketed text, music cues, duplicate cues, empty cues, extra line breaks, and ALL-CAPS text.' },
    { question: 'Will it remove real dialogue?', answer: 'Safe rules are on by default. Speaker labels and SDH notes stay off, along with watermarks or merged cues, because they can remove useful text.' },
    { question: 'Does cleaning change subtitle timing?', answer: 'No. The cleaner changes subtitle text and keeps the original timing and file format.' },
  ]} />

  <RelatedTools tools={[
    { href: '/subtitle-validator', label: 'Validate the cleaned file', description: 'Find empty cues and overlap or malformed-timestamp problems.' },
    { href: '/convert-to-plain-text', label: 'Extract dialogue', description: 'Remove all timing and formatting to make a transcript.' },
    { href: '/utf-8-converter', label: 'Repair garbled text', description: 'Convert the source encoding before you clean it.' },
    { href: '/subtitle-shifter', label: 'Fix subtitle timing', description: 'Move every cue earlier or later by one offset.' },
  ]} />
</Layout>

<script>
  import { write } from '../engine/formats.ts';
  import { clean, type CleanOptions } from '../engine/clean.ts';
  import { mountTool } from '../components/tool-shell.ts';

  const form = document.getElementById('opts') as HTMLFormElement;

  function options(): Partial<CleanOptions> {
    const data = new FormData(form);
    const opts: Record<string, unknown> = { keep: data.getAll('keep') };
    for (const [k, v] of data) if (k !== 'keep') opts[k] = v === 'on';
    return opts;
  }

  const render = mountTool({
    view({ file }, { previewLimit = 200 } = {}) {
      const r = clean(file, options());
      // Only changed cues: an unchanged Before/After pair tells you nothing.
      const changed = file.cues
        .map((c, i) => ({ cells: [String(i + 1), c.text, r.after[i] ?? 'removed'], flag: r.after[i] !== c.text || r.changed.includes(i + 1) }))
        .filter((row) => row.flag);
      const rows = changed.length ? changed.slice(0, previewLimit) : [{ cells: ['', 'No cues change with these settings.'] }];
      return { warnings: [], rows, result: `${r.changed.length} cues changed, ${r.removed.length} removed.`, total: changed.length };
    },
    output: ({ file }) => write(clean(file, options()).file),
  });

  const html = form.elements.namedItem('htmlTags') as HTMLInputElement;
  const keep = document.getElementById('keep') as HTMLFieldSetElement;
  form.addEventListener('change', () => {
    keep.disabled = !html.checked;
    render();
  });
</script>

<style>
  /* Every row: a fixed label column on the left, pill toggles flowing right. Checked pills get a cream fill. */
  form, .rows { display: grid; gap: 12px; }
  .rows { margin-top: 12px; }
  fieldset { border: 0; padding: 0 0 0 128px; margin: 0; min-width: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; position: relative; }
  legend { position: absolute; left: 0; top: 9px; padding: 0; font-size: 14px; color: var(--graphite); }
  .chip { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border: 1px solid var(--ink); border-radius: var(--pill); font-size: 16px; cursor: pointer; }
  .chip:hover { background: var(--cream); }
  .chip:has(:checked) { background: var(--cream); box-shadow: 0 0 0 1px var(--ink); }
  .hint { font-size: 14px; color: var(--graphite); }
  fieldset { transition: opacity .2s; }
  fieldset:disabled { opacity: 0.4; }
  fieldset:disabled .chip:active { scale: 1; }
  fieldset:disabled .chip { cursor: default; }
  summary { margin-left: 128px; font-size: 14px; color: var(--graphite); cursor: pointer; width: fit-content; }
  summary:hover { color: var(--ink); }

  @media (max-width: 640px) {
    form, .rows { gap: 20px; }
    fieldset { padding-left: 0; }
    summary { margin-left: 0; }
    legend { position: static; width: 100%; margin-bottom: 4px; }
  }
</style>
