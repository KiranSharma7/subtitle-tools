---
import Layout from '../layouts/Layout.astro';
import { guides } from '../guides.ts';
---

<Layout title="Subtitle guides" description="Plain guides to subtitle files: what SRT, VTT and LRC files are, how to open and make them, and how to fix subtitles that are out of sync.">
  <h1>Subtitle guides</h1>
  <p class="lede">What subtitle files are, how to open and make them, and how to fix the usual problems.</p>
  <ul class="list">
    {guides.map((g) => (
      <li>
        <a href={g.href}>{g.title}</a>
        <p>{g.blurb}</p>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .list { list-style: none; padding: 0; margin: 0 auto; max-width: 760px; display: grid; gap: 16px; }
  .list li { position: relative; border: 1px solid var(--ink); border-radius: var(--radius); padding: 24px 28px; transition: box-shadow .15s, scale .15s; }
  .list li:hover { box-shadow: 0 0 0 1px var(--ink); background: var(--cream); }
  .list li:active { scale: .99; }
  .list a { font-size: 22px; line-height: 1.3; font-weight: 500; text-decoration: none; }
  .list a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .list p { margin: 8px 0 0; color: var(--graphite); }
</style>
