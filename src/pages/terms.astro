---
import Layout from '../layouts/Layout.astro';
import { site } from '../site.ts';
---

<Layout title="Terms of use" description={`Terms for using ${site.name}'s free subtitle tools and downloaded files.`}>
  <article class="doc">
    <h1>Terms of use</h1>
    <p>{site.name} provides free browser tools for subtitle files. By using the site, you agree to these terms.</p>
    <h2>Your files</h2>
    <p>Your files stay on your device and remain yours. You are responsible for having the right to edit and download the files you use.</p>
    <h2>No warranty</h2>
    <p>The tools are provided as they are. Check every result before publishing or relying on it, and keep your original file.</p>
    <h2>Liability</h2>
    <p>As far as the law allows, we aren't liable for any loss that comes from using the site or its output.</p>
    <h2>Changes</h2>
    <p>We may change these terms. The version on this page is the one that applies.</p>
    <p>Questions: <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </article>
</Layout>
