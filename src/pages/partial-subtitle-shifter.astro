---
import Layout from '../layouts/Layout.astro';
import ToolShell from '../components/ToolShell.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
---

<Layout title="Shift part of an SRT file" description="Fix one section of an SRT, WebVTT, ASS, SAMI, MicroDVD, or MPL2 file with a different timing offset. Files stay on your device.">
  <h1>Shift part of a subtitle file</h1>
  <p class="lede">Fix a subtitle section that is out of sync after an ad break, cut, or scene change.</p>

  <ToolShell columns={['#', 'Before', 'After', 'Range', 'Text']}>
    <div id="ranges"></div>
    <button id="add" type="button">Add range</button>
    <template id="range-row">
      <fieldset>
        <legend></legend>
        <label>From <input class="from" value="00:00:00,000" /></label>
        <label>To <input class="to" value="00:10:00,000" /></label>
        <label>Shift by <input class="offset" type="number" step="any" value="1" /> seconds</label>
        <button class="remove" type="button">Remove</button>
      </fieldset>
    </template>
  </ToolShell>

  <section class="help">
    <h2>How to shift part of a subtitle file</h2>
    <p>Add a range for each section that needs a different offset. Type the start and end times shown in the preview. A positive value moves cues later; a negative value moves them earlier.</p>
    <pre><code>00:00:00–00:18:42   0 seconds
00:18:42–00:42:10  -1.5 seconds</code></pre>
    <h2>Supported subtitle formats</h2>
    <p>Use SRT, WebVTT, ASS, SSA, SAMI, MicroDVD, or MPL2. The downloaded file keeps its original format and filename.</p>
    <h2>How time ranges work</h2>
    <p>A cue belongs to the range where its start time falls. A cue starting exactly at the <strong>To</strong> time belongs outside that range. Ranges cannot overlap, and each cue moves as a whole.</p>
    <h2>When to use a different fix</h2>
    <p>Use a frame-rate retime when subtitles drift slowly from start to finish. If one offset fixes the whole file, the <a href="/subtitle-shifter">subtitle delay fixer</a> is faster.</p>
    <h2>Warnings you may see</h2>
    <p>Cues moved before 0:00 are clamped. Cues ending before 0:00 are removed, and new overlaps are flagged for review. <a href="/subtitle-validator">Validate the final file</a> after checking those rows.</p>
  </section>

  <Faq items={[
    { question: 'When should I shift part of a subtitle file?', answer: 'Use it when one section is out of sync after a cut, ad break, or scene change.' },
    { question: 'Does a cue move if it starts at the To time?', answer: 'No. A cue starting at the To time belongs outside that range.' },
    { question: 'Can this fix slow timing drift?', answer: 'No. Slow drift usually needs a frame-rate retime. Use a partial shift when the timing changes at a clear point.' },
  ]} />

  <RelatedTools tools={[
    { href: '/subtitle-shifter', label: 'Shift the whole file', description: 'Apply one delay when every cue is early or late.' },
    { href: '/subtitle-validator', label: 'Validate the result', description: 'Check ordering and overlap, timestamp, or empty-cue problems.' },
    { href: '/srt-cleaner', label: 'Clean the file', description: 'Remove tags and notes after the timing is fixed.' },
    { href: '/convert-to-srt', label: 'Convert to SRT', description: 'Change the format once the timing is right.' },
  ]} />
</Layout>

<script>
  import { write } from '../engine/formats.ts';
  import { shiftRanges, type Range } from '../engine/shift.ts';
  import { formatTime, parseTime } from '../engine/time.ts';
  import type { SubtitleFile } from '../engine/types.ts';
  import { mountTool } from '../components/tool-shell.ts';

  const list = document.getElementById('ranges')!;
  const tpl = document.getElementById('range-row') as HTMLTemplateElement;

  function readRanges(): Range[] | string {
    const out: Range[] = [];
    for (const [i, f] of [...list.children].entries()) {
      const v = (c: string) => (f.querySelector(c) as HTMLInputElement).value;
      const from = parseTime(v('.from'));
      const to = parseTime(v('.to'));
      if (from === null || to === null) return `Range ${i + 1}: type times like 00:01:30,000.`;
      out.push({ from, to, offset: Math.round((parseFloat(v('.offset')) || 0) * 1000) });
    }
    return out;
  }

  function run(file: SubtitleFile) {
    const ranges = readRanges();
    return typeof ranges === 'string' ? { error: ranges } : shiftRanges(file, ranges);
  }

  const render = mountTool({
    view({ file }, { previewLimit = 200 } = {}) {
      const t = (ms: number) => formatTime(ms, file.format === 'srt' ? ',' : '.');
      const r = run(file);
      if ('error' in r) return { warnings: [`${r.error} Nothing is shifted.`], rows: file.cues.slice(0, previewLimit).map((c, i) => ({ cells: [String(i + 1), t(c.start), t(c.start), '', c.text] })), total: file.cues.length };

      const warnings: string[] = [];
      if (r.clamped.length) warnings.push(`Moved to 0:00 because they would start too early: cue ${r.clamped.join(', ')}.`);
      if (r.removed.length) warnings.push(`Removed because they would end before 0:00: cue ${r.removed.join(', ')}.`);
      if (r.overlaps.length) warnings.push(`Now overlap a cue outside their range: cue ${r.overlaps.join(', ')}.`);

      const removed = new Set(r.removed);
      let j = 0;
      const rows = file.cues.slice(0, previewLimit).map((c, i) => {
        const after = removed.has(i + 1) ? 'removed' : t(r.file.cues[j++].start);
        const k = r.range[i];
        return {
          cells: [String(i + 1), t(c.start), after, k === null ? '' : `Range ${k + 1}`, c.text],
          flag: removed.has(i + 1) || r.clamped.includes(i + 1) || r.overlaps.includes(i + 1),
        };
      });
      return { warnings, rows, total: file.cues.length };
    },
    output({ file }) {
      const r = run(file);
      return write('error' in r ? file : r.file);
    },
  });

  function renumber() {
    [...list.children].forEach((f, i) => (f.querySelector('legend')!.textContent = `Range ${i + 1}`));
    render();
  }

  function addRange() {
    const row = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    row.querySelector('.remove')!.addEventListener('click', () => (row.remove(), renumber()));
    list.append(row);
    renumber();
  }

  list.addEventListener('input', render);
  document.getElementById('add')!.addEventListener('click', addRange);
  addRange();
</script>

<style>
  #ranges { display: grid; gap: 16px; }
  fieldset { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; }
  legend { float: left; font-weight: 600; }
  label { display: flex; gap: 8px; align-items: center; }
  .from, .to { width: 9em; font-variant-numeric: tabular-nums; }
  input[type='number'] { width: 6em; }
  #add, .remove { justify-self: start; background: transparent; color: var(--ink); border: 1px solid var(--ink); border-radius: var(--radius); padding: 7px 16px; font-weight: 500; cursor: pointer; }
  #add:hover, .remove:hover { background: var(--cream); }
  #ranges fieldset { animation: rise .3s var(--spring) both; }
  :global(.tool td:nth-child(-n + 3)) { white-space: nowrap; font-variant-numeric: tabular-nums; }
  :global(.tool td:last-child) { width: 100%; }
</style>
