---
import Layout from '../layouts/Layout.astro';
import ToolShell from '../components/ToolShell.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
---

<Layout title="Fix subtitle delay online" description="Fix out-of-sync SRT, WebVTT, ASS, SAMI, MicroDVD, or MPL2 subtitles. Shift every cue earlier or later by seconds or milliseconds in your browser.">
  <h1>Fix subtitle delay in SRT and VTT files</h1>
  <p class="lede">Move every subtitle earlier or later by the same amount to fix a constant delay.</p>

  <ToolShell columns={['#', 'Start', 'Text']}>
    <fieldset>
      <legend>Shift by</legend>
      <input id="amount" type="number" min="0" step="any" value="1" aria-label="Amount" />
      <select id="unit" aria-label="Unit">
        <option value="1000">seconds</option>
        <option value="1">milliseconds</option>
      </select>
      <select id="dir" aria-label="Direction">
        <option value="1">later</option>
        <option value="-1">earlier</option>
      </select>
    </fieldset>
  </ToolShell>

  <section class="help">
    <h2>How to fix a subtitle delay</h2>
    <p>Compare one spoken line with its subtitle. A late subtitle needs an earlier shift. An early subtitle needs a later shift.</p>
    <pre><code>Subtitle is 2 seconds late  →  shift earlier by 2 seconds
Subtitle is 1.5 seconds early →  shift later by 1.5 seconds</code></pre>
    <h2>Supported subtitle formats</h2>
    <p>Shift SRT, WebVTT, ASS, SSA, SAMI, MicroDVD or MPL2 files. The download keeps the uploaded format, styles, cue settings, and filename.</p>
    <h2>Constant delay or timing drift?</h2>
    <p>This tool applies one fixed offset to the whole file. If subtitles start in sync and drift over time, the video and subtitle may use different frame rates. Use the <a href="/partial-subtitle-shifter">partial subtitle shifter</a> after a cut or ad break.</p>
    <h2>Warnings you may see</h2>
    <p>Cues moved before 0:00 are clamped to 0:00. Cues that end before 0:00 are removed. Both changes are listed above the preview. MicroDVD uses frames, so choose the video's frame rate when the file does not state one.</p>
    <p>When the timing looks right, <a href="/subtitle-validator">validate the shifted file</a> before sharing it.</p>
  </section>

  <Faq title="Subtitle delay FAQ" items={[
    { question: 'How do I fix subtitles that are too early or too late?', answer: 'Shift late subtitles earlier. Shift early subtitles later.' },
    { question: 'Can this fix subtitles that drift over time?', answer: 'It fixes one constant delay. If the delay grows during the video, the subtitle and video may use different frame rates.' },
    { question: 'What happens to cues before zero?', answer: 'Cues that start before 0:00 are moved to 0:00. Cues that end before 0:00 are removed and listed above the preview.' },
  ]} />

  <RelatedTools tools={[
    { href: '/partial-subtitle-shifter', label: 'Shift one section', description: 'Use a different offset after a cut, ad break, or scene change.' },
    { href: '/subtitle-validator', label: 'Check the result', description: 'Find overlaps, bad timestamps, and empty cues.' },
    { href: '/convert-to-webvtt', label: 'Convert to WebVTT', description: 'Prepare the shifted subtitles for HTML5 video.' },
    { href: '/srt-cleaner', label: 'Clean the file', description: 'Remove tags, SDH notes, and duplicate cues.' },
  ]} />
</Layout>

<script>
  import { write } from '../engine/formats.ts';
  import { shift } from '../engine/shift.ts';
  import { formatTime } from '../engine/time.ts';
  import { mountTool } from '../components/tool-shell.ts';

  const amount = document.getElementById('amount') as HTMLInputElement;
  const unit = document.getElementById('unit') as HTMLSelectElement;
  const dir = document.getElementById('dir') as HTMLSelectElement;

  // "12 cues shifted 1.5 seconds earlier."
  function result(count: number) {
    const n = parseFloat(amount.value) || 0;
    if (!n) return 'Nothing shifted yet. Set an amount above.';
    const u = unit.selectedOptions[0].text;
    return `${count} ${count === 1 ? 'cue' : 'cues'} shifted ${n} ${n === 1 ? u.slice(0, -1) : u} ${dir.selectedOptions[0].text}.`;
  }

  function offset() {
    return Math.round((parseFloat(amount.value) || 0) * +unit.value * +dir.value);
  }

  const render = mountTool({
    view({ file }, { previewLimit = 200 } = {}) {
      const r = shift(file, offset());
      const warnings: string[] = [];
      if (r.clamped.length) warnings.push(`Moved to 0:00 because they would start too early: cue ${r.clamped.join(', ')}.`);
      if (r.removed.length) warnings.push(`Removed because they would end before 0:00: cue ${r.removed.join(', ')}.`);

      const t = (ms: number) => formatTime(ms, file.format === 'srt' ? ',' : '.');
      const removed = new Set(r.removed);
      let j = 0;
      const rows = file.cues.slice(0, previewLimit).map((c, i) => {
        const after = removed.has(i + 1) ? 'removed' : t(r.file.cues[j++].start);
        return { cells: [String(i + 1), after, c.text], flag: removed.has(i + 1) || r.clamped.includes(i + 1) };
      });
      return { warnings, rows, result: result(r.file.cues.length), total: file.cues.length };
    },
    output: ({ file }) => write(shift(file, offset()).file),
  });

  for (const el of [amount, unit, dir]) el.addEventListener('input', render);
</script>

<style>
  fieldset { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  legend { float: left; margin-right: 8px; font-weight: 600; }
  input[type='number'] { width: 7em; }
  @media (max-width: 640px) {
    legend { float: none; width: 100%; margin: 0 0 8px; padding: 0; }
    fieldset > :not(legend) { flex: 1; min-width: 0; }
  }
  :global(.tool td:nth-child(-n + 2)) { white-space: nowrap; font-variant-numeric: tabular-nums; }
  :global(.tool td:last-child) { width: 100%; }
</style>
