---
import Layout from '../layouts/Layout.astro';
import ToolShell from '../components/ToolShell.astro';
---

<Layout title="Convert to WebVTT: turn SRT, ASS, SAMI and other subtitles into VTT" description="Convert SRT, ASS, SSA, SAMI, MicroDVD or MPL2 subtitles to WebVTT (.vtt) for HTML5 video in your browser. Free, and your file stays on your device.">
  <h1>Convert to WebVTT</h1>
  <p class="lede">Turn an SRT, ASS or other subtitle file into WebVTT, the format web video players use.</p>

  <ToolShell columns={['#', 'Start', 'End', 'Text']} />

  <section class="help">
    <h2>How to use it</h2>
    <p>Choose an SRT, ASS, SSA, SAMI, MicroDVD or MPL2 file. The preview shows the cues as they will be written.</p>
    <p>SRT converts with nothing lost. ASS styles, positions and karaoke timing have no WebVTT equivalent, so they are dropped. Anything that gets dropped is listed above the preview, with the cue numbers it affects.</p>
    <p>The download is saved as UTF-8 with the same name and a <code>.vtt</code> extension.</p>
  </section>
</Layout>

<script>
  import { mountConverter } from '../components/converter.ts';
  mountConverter('vtt');
</script>

<style>
  .tool :global(td:nth-child(-n + 3)) { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .help { margin-top: 80px; max-width: 640px; }
  .help p { color: var(--graphite); }
</style>
