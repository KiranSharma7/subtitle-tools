---
import Layout from '../layouts/Layout.astro';
import ToolShell from '../components/ToolShell.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
---

<Layout title="SRT to WebVTT converter online" description="Convert SRT, ASS, SSA, SAMI, MicroDVD, or MPL2 subtitles to WebVTT for HTML5 video. Preview changes before download.">
  <h1>Convert SRT to WebVTT</h1>
  <p class="lede">Convert SRT to WebVTT for an HTML5 <code>&lt;track&gt;</code>, a web video player, or any upload that needs <code>.vtt</code>.</p>

  <ToolShell columns={['#', 'Start', 'End', 'Text']} />

  <section class="help">
    <h2>How to convert SRT to WebVTT</h2>
    <p>Upload the subtitle file, review the cue preview, and download a UTF-8 WebVTT file. The converter adds the required <code>WEBVTT</code> header.</p>
    <h2>Supported input formats</h2>
    <p>Convert SRT, ASS, SSA, SAMI, MicroDVD, or MPL2. SRT is the common choice for web captions. MicroDVD uses video frames, so select the video's frame rate when the file does not include one.</p>
    <h2>SRT and WebVTT timestamps</h2>
    <p>SRT uses a comma before milliseconds. WebVTT uses a period. The converter changes the separator and keeps each cue's start and end time.</p>
    <pre><code>SRT:  00:00:12,400 --> 00:00:14,800
VTT:  00:00:12.400 --> 00:00:14.800</code></pre>
    <h2>What happens to styles?</h2>
    <p>Bold, italic, and underline can stay. ASS positions, karaoke timing, and other ASS-only styles are removed and listed because WebVTT cannot represent them the same way.</p>
    <h2>When a browser rejects the file</h2>
    <p>Check that the download ends in <code>.vtt</code> and starts with <code>WEBVTT</code>, as the <a href="https://www.w3.org/TR/webvtt1/">W3C WebVTT specification</a> requires. If times look wrong, check the source encoding or frame rate. Then <a href="/subtitle-validator">validate the WebVTT file</a>.</p>
  </section>

  <Faq title="WebVTT converter FAQ" items={[
    { question: 'Can I convert SRT to WebVTT?', answer: 'Yes. Upload the SRT file and download a WebVTT file with the required WEBVTT header.' },
    { question: 'Why do WebVTT timestamps use dots?', answer: 'SRT uses a comma before milliseconds. WebVTT uses a period. The converter changes this for you.' },
    { question: 'Will ASS styles work in WebVTT?', answer: 'Basic bold, italic, and underline can stay. ASS positions, karaoke timing, and other ASS-only styles are removed and listed.' },
  ]} />

  <RelatedTools tools={[
    { href: '/convert-to-srt', label: 'Convert back to SRT', description: 'Make an SRT for players and editors that do not accept WebVTT.' },
    { href: '/subtitle-validator', label: 'Validate WebVTT', description: 'Check the header, timestamps, order, and cue text.' },
    { href: '/subtitle-shifter', label: 'Fix subtitle timing', description: 'Move every cue earlier or later by one offset.' },
    { href: '/srt-cleaner', label: 'Clean the captions', description: 'Remove tags and SDH notes before publishing.' },
  ]} />
</Layout>

<script>
  import { mountConverter } from '../components/converter.ts';
  mountConverter('vtt');
</script>

<style>
  :global(.tool td:nth-child(-n + 3)) { white-space: nowrap; font-variant-numeric: tabular-nums; }
  :global(.tool td:last-child) { width: 100%; }
</style>
