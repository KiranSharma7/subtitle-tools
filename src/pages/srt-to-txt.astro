---
import Layout from '../layouts/Layout.astro';
import ToolShell from '../components/ToolShell.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
---

<Layout title="Convert SRT to text online" description="Convert SRT, WebVTT, ASS, SSA, SAMI, MicroDVD, or MPL2 subtitles to plain text. Remove timestamps and cue numbers in your browser.">
  <h1>Convert SRT to plain text</h1>
  <p class="lede">Extract a clean transcript from SRT and other subtitle files. Timings and cue numbers are removed.</p>

  <ToolShell columns={['#', 'Text']}>
    <label class="option"><input id="keep" type="checkbox" checked /> Keep line breaks</label>
  </ToolShell>

  <section class="help">
    <h2>How to convert SRT to TXT</h2>
    <p>Upload SRT, WebVTT, ASS, SSA, SAMI, MicroDVD, MPL2, or LRC. The preview keeps dialogue and removes timestamps, cue numbers, WebVTT settings, headers, and formatting tags.</p>
    <h2>Choose your text layout</h2>
    <p>Keep line breaks to preserve two-line cues and separate cues with a blank line. Turn it off to put each cue on one line for a compact transcript.</p>
    <pre><code>Keep line breaks:  I wanted to tell you something.
                  But I did not know how.

One line per cue: I wanted to tell you something. But I did not know how.</code></pre>
    <h2>What gets removed?</h2>
    <p>Timing, cue numbers, IDs, WebVTT settings and file headers are removed, along with ASS formatting tags. A cue that has no text left is left out. Plain text has no timing, so it cannot be converted back into subtitles without adding timings again.</p>
    <h2>If the transcript needs cleanup</h2>
    <p>If the transcript contains tags or SDH descriptions, <a href="/srt-cleaner">clean the subtitle first</a>. If accents or non-Latin text look garbled, use the <a href="/utf-8-converter">UTF-8 converter</a> and try again.</p>
  </section>

  <Faq title="SRT to text FAQ" items={[
    { question: 'Can I convert SRT to TXT?', answer: 'Yes. Upload the SRT file and download a plain text file with its dialogue.' },
    { question: 'Are timestamps kept in the text file?', answer: 'No. Timestamps and cue numbers are removed. Header lines and WebVTT settings are removed too. Formatting tags are removed as well.' },
    { question: 'What does Keep line breaks do?', answer: 'It keeps the lines inside each subtitle cue. Turn it off to put each cue on one line.' },
  ]} />

  <RelatedTools tools={[
    { href: '/srt-cleaner', label: 'Clean before extracting', description: 'Remove HTML tags and SDH notes, plus labels or duplicate cues.' },
    { href: '/utf-8-converter', label: 'Fix the text encoding', description: 'Repair mojibake before making a transcript.' },
    { href: '/convert-to-srt', label: 'Keep subtitle timing', description: 'Convert another subtitle format to SRT instead of plain text.' },
    { href: '/convert-to-webvtt', label: 'Make web captions', description: 'Convert to WebVTT when you need timed captions instead.' },
  ]} />
</Layout>

<script>
  import { plainText, write } from '../engine/formats.ts';
  import { convert } from '../engine/convert.ts';
  import { mountTool } from '../components/tool-shell.ts';
  import { lossWarnings } from '../components/converter.ts';

  const keep = document.getElementById('keep') as HTMLInputElement;

  const render = mountTool({
    view({ file }, { previewLimit = 200 } = {}) {
      const r = convert(file, 'txt');
      const rows = [];
      for (const [i, cue] of r.file.cues.entries()) {
        const value = plainText(cue.text, keep.checked);
        if (value) rows.push({ cells: [String(i + 1), value] });
        if (rows.length >= previewLimit) break;
      }
      return {
        warnings: lossWarnings(r.losses),
        // Cues with no text left are left out of the download, so leave them out here too.
        rows,
      };
    },
    output: ({ file }) => write(file, 'txt', { keepLineBreaks: keep.checked }),
    filename: (name) => name.replace(/\.[^.]*$/, '') + '.txt',
  });

  keep.addEventListener('change', render);
</script>

<style>
  .option { display: flex; gap: 8px; align-items: center; font-weight: 600; }
  :global(.tool td:first-child) { white-space: nowrap; font-variant-numeric: tabular-nums; }
</style>
